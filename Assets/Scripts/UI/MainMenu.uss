.screen {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  padding: 32px 24px;
  background-color: rgb(20, 16, 14);
  align-items: center;
  justify-content: center;
}

.atmosphere {
  position: absolute;
  left: -10%;
  right: -10%;
  top: -5%;
  bottom: -5%;
  background-color: rgb(58, 44, 32);
  opacity: 0.4;
}

.plaque {
  position: relative;
  width: 460px;
  max-width: 92%;
  max-height: 92%;
  padding: 22px 24px 18px 24px;
  background-color: rgba(22, 16, 12, 0.94);
  border-radius: 8px;
  border-width: 2px;
  border-color: rgb(212, 176, 106);
  align-items: stretch;
  flex-shrink: 1;
  overflow: hidden;
  transition-property: opacity, translate;
  transition-duration: 0.18s;
  transition-timing-function: ease-out;
}

.panel-body {
  align-items: stretch;
  flex-grow: 1;
  flex-shrink: 1;
  overflow: hidden;
}

.brand {
  color: rgb(242, 214, 140);
  font-size: 42px;
  -unity-font-style: bold;
  margin-top: 4px;
  margin-bottom: 6px;
  -unity-text-align: middle-center;
  letter-spacing: 1px;
}

.brand-compact {
  font-size: 26px;
  margin-bottom: 8px;
}

.compact-header {
  justify-content: center;
}

.subtitle {
  color: rgb(186, 168, 142);
  font-size: 14px;
  margin-bottom: 16px;
  -unity-text-align: middle-center;
  white-space: normal;
  max-width: 100%;
}

.panel-title {
  color: rgb(242, 214, 140);
  font-size: 20px;
  -unity-font-style: bold;
  margin-bottom: 10px;
  -unity-text-align: middle-center;
}

.menu-button {
  height: 40px;
  margin-top: 4px;
  margin-bottom: 0;
  font-size: 15px;
  background-color: rgb(48, 38, 30);
  color: rgb(244, 236, 220);
  border-radius: 5px;
  border-width: 1px;
  border-color: rgba(212, 176, 106, 0.35);
  transition-property: background-color, border-color;
  transition-duration: 0.12s;
}

.menu-button:hover {
  background-color: rgb(68, 52, 40);
  border-color: rgba(242, 214, 140, 0.75);
}

.menu-button:active {
  background-color: rgb(58, 44, 34);
}

.difficulty-button {
  height: auto;
  min-height: 0;
  margin-top: 4px;
  margin-bottom: 0;
  padding: 6px 12px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}

.diff-name {
  color: rgb(244, 236, 220);
  font-size: 15px;
  -unity-font-style: bold;
  margin: 0;
  padding: 0;
}

.diff-hint {
  color: rgb(168, 150, 128);
  font-size: 11px;
  margin: 1px 0 0 0;
  padding: 0;
  white-space: normal;
}

.secondary {
  background-color: rgb(36, 28, 22);
  margin-top: 12px;
}

.body {
  color: rgb(220, 208, 188);
  font-size: 14px;
  white-space: normal;
  margin-bottom: 10px;
}

.dialog {
  position: absolute;
  left: 50%;
  top: 50%;
  translate: -50% -50%;
  z-index: 10;
  width: 400px;
  max-width: 90%;
}

.panel-saves {
  min-height: 0;
}

.panel-account {
  min-height: 0;
}

.panel-feedback {
  min-height: 0;
}

.account-status {
  color: rgb(186, 168, 142);
  padding: 8px;
  background-color: rgba(48, 38, 30, 0.55);
  border-radius: 5px;
  border-width: 1px;
  border-color: rgba(212, 176, 106, 0.28);
}

.account-field {
  margin-top: 4px;
  margin-bottom: 4px;
  color: rgb(244, 236, 220);
}

.feedback-field {
  margin-top: 4px;
  margin-bottom: 4px;
  color: rgb(244, 236, 220);
}

.feedback-note {
  min-height: 88px;
}

.feedback-hint {
  color: rgb(168, 150, 128);
  font-size: 12px;
  margin-top: 2px;
  margin-bottom: 6px;
}

.feedback-status {
  min-height: 20px;
  color: rgb(242, 214, 140);
  margin-bottom: 4px;
}

.saves-scroll {
  max-height: 280px;
  margin-bottom: 8px;
  flex-grow: 1;
}

.saves-rows {
  align-items: stretch;
}

.save-row {
  margin-top: 6px;
  margin-bottom: 6px;
  padding: 8px;
  background-color: rgba(32, 24, 18, 0.92);
  border-radius: 5px;
  border-width: 1px;
  border-color: rgba(212, 176, 106, 0.25);
}

.cloud-save-row {
  background-color: rgba(42, 36, 28, 0.94);
  border-color: rgba(212, 176, 106, 0.35);
}

.save-name {
  color: rgb(242, 214, 140);
  font-size: 15px;
  -unity-font-style: bold;
  white-space: normal;
}

.save-meta {
  color: rgb(186, 168, 142);
  font-size: 12px;
  white-space: normal;
  margin-top: 4px;
}

.save-status {
  color: rgb(210, 160, 140);
  font-size: 12px;
  white-space: normal;
  margin-top: 4px;
}

.hidden {
  display: none;
}

/* Legacy class kept so older panel class references do not break */
.panel {
  /* unused — chrome lives on .plaque */
}
