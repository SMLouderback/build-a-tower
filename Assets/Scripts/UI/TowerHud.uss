.root {
  position: absolute;
  left: 12px;
  top: 12px;
  padding: 10px;
  background-color: rgba(10, 14, 22, 0.92);
  border-radius: 8px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.25);
  width: 240px;
  height: auto;
  min-height: 180px;
}

.title {
  color: rgb(255, 220, 120);
  font-size: 16px;
  -unity-font-style: bold;
  margin-bottom: 4px;
}

.help {
  color: rgb(230, 235, 245);
  font-size: 11px;
  white-space: normal;
  margin-bottom: 6px;
}

.funds, .tool, .cell, .controls {
  color: rgb(210, 215, 225);
  margin-bottom: 2px;
  font-size: 11px;
}

.controls {
  margin-top: 2px;
  margin-bottom: 4px;
  color: rgb(170, 180, 195);
}

.section {
  color: rgb(255, 220, 120);
  font-size: 11px;
  -unity-font-style: bold;
  margin-top: 6px;
  margin-bottom: 2px;
}

.toolbar {
  flex-direction: row;
  flex-wrap: wrap;
}

.toolbar Button {
  margin: 2px;
  height: 28px;
  width: 108px;
}

.tool-button {
  margin: 2px;
  height: 28px;
  width: 220px;
}
